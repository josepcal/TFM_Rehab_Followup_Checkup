# FTM stack — environment template.
# In production these values live SOPS-encrypted (PR3) and are rendered to a tmpfs .env
# by cloud-init. This .example documents the required keys — NEVER put real secrets here.

# --- Deploy-time injected (by cloud-init, not secrets) ---
DOMAIN=ftm-demo.duckdns.org
STACK_PRIVATE_IP=10.0.1.20
API_IMAGE=ghcr.io/josepcal/tfm_rehab_followup_checkup/api:latest
# --- Keycloak DB ---
KC_DB_NAME=keycloak
KC_DB_USER=keycloak
KC_DB_PASSWORD=change-me

# --- Keycloak admin + realm ---
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=change-me
KC_REALM=ftm
OIDC_AUDIENCE=ftm-api

# --- App DB ---
ADMIN_DB_USER=ftm_admin
ADMIN_DB_PASSWORD=change-me
APP_DB_NAME=ftm
APP_DB_USER=ftm_app
APP_DB_PASSWORD=change-me

# --- MinIO ---
MINIO_ROOT_USER=ftm-admin
MINIO_ROOT_PASSWORD=change-me
MINIO_APP_USER=ftm-recordings-svc
MINIO_APP_PASSWORD=change-me
MINIO_BUCKET=ftm-recordings
MINIO_REGION=eu-central-1

# --- LLM ---
#LLM_API_KEY=change-me Out of Scope for MVP
