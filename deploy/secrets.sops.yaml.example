# PLAINTEXT TEMPLATE — do NOT commit a filled-in version of this file.
# Fill real values here, then encrypt into secrets.sops.yaml (which IS safe to commit,
# because SOPS encrypts the values). After encrypting, delete this filled copy.
#
#   sops --encrypt --age age1YOURPUBKEY deploy/secrets.sops.yaml.example > deploy/secrets.sops.yaml
#
# These become the .env the stack VM renders to tmpfs at boot.

# LUKS passphrase for the encrypted data volume (task 1.4).
LUKS_PASSPHRASE: change-me-long-random

# Keycloak DB
KC_DB_NAME: keycloak
KC_DB_USER: keycloak
KC_DB_PASSWORD: change-me

# Keycloak admin + realm
KC_ADMIN_USER: admin
KC_ADMIN_PASSWORD: change-me
KC_REALM: ftm
OIDC_AUDIENCE: ftm-api

# App DB
APP_DB_NAME: ftm
APP_DB_USER: ftm_app
APP_DB_PASSWORD: change-me

# MinIO
MINIO_ROOT_USER: ftm-admin
MINIO_ROOT_PASSWORD: change-me
MINIO_APP_USER: ftm-recordings-svc
MINIO_APP_PASSWORD: change-me
MINIO_BUCKET: ftm-recordings
MINIO_REGION: eu-central-1

# LLM
LLM_API_KEY: change-me

# Image (non-secret, but rendered alongside)
API_IMAGE: ghcr.io/josepcal/tfm_rehab_followup_checkup/api:latest