{
  "realm": "ftm",
  "enabled": true,
  "displayName": "FTM - Medical Rehab Follow-up",
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "verifyEmail": false,
  "defaultSignatureAlgorithm": "RS256",
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      {
        "name": "medical",
        "description": "Medico (fusiona GP + especialista)"
      },
      {
        "name": "patient",
        "description": "Paciente"
      },
      {
        "name": "technician",
        "description": "Tecnico (escribe funciones de analisis de audio)"
      },
      {
        "name": "admin",
        "description": "Administrador del sistema"
      }
    ]
  },
  "clients": [
    {
      "clientId": "ftm-web",
      "name": "FTM Web (SPA React)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "rootUrl": "https://__DOMAIN__",
      "baseUrl": "https://__DOMAIN__",
      "redirectUris": [
        "https://__DOMAIN__/*"
      ],
      "webOrigins": [
        "https://__DOMAIN__"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "protocolMappers": [
        {
          "name": "ftm-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "ftm-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ],
      "fullScopeAllowed": true
    },
    {
      "clientId": "ftm-api",
      "name": "FTM API (FastAPI, bearer-only)",
      "enabled": true,
      "protocol": "openid-connect",
      "bearerOnly": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true
    }
  ],
  "users": [
    {
      "username": "medico1",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Ana M",
      "lastName": "Lopez",
      "email": "medico1@ftm.local",
      "credentials": [
        {
          "type": "password",
          "value": "medico1",
          "temporary": true
        }
      ],
      "realmRoles": [
        "medical"
      ],
      "id": "idp|doctor-default"
    },
    {
      "username": "paciente1",
      "enabled": true,
      "emailVerified": true,
      "firstName": "José",
      "lastName": "Demo",
      "email": "paciente1@ftm.local",
      "credentials": [
        {
          "type": "password",
          "value": "paciente1",
          "temporary": true
        }
      ],
      "realmRoles": [
        "patient"
      ],
      "id": "idp|patient-default"
    },
    {
