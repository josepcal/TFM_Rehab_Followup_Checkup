#cloud-config
# The stack VM has NO public IP; its only route to the internet is via the edge
# acting as a NAT gateway. Hetzner's DHCP does NOT hand out a default route on the
# private network (only classless routes for 10.0.0.0/16), so we add one ourselves.
# The `onlink` flag is REQUIRED — cloud-init tears down the scope-link route to the
# gateway during network setup, so without `onlink` the kernel rejects the gateway
# as unreachable ("Nexthop has invalid gateway"). We retry because at early boot the
# interface may not have its DHCP IP yet.
bootcmd:
  - ["sh", "-c", "for i in $(seq 1 30); do IF=$(ip -o -4 addr show scope global | grep -o 'enp[0-9a-z]*' | head -1); [ -n \"$IF\" ] && ip route replace default via ${subnet_gateway} dev \"$IF\" onlink && break; sleep 2; done"]
  # Point systemd-resolved at Hetzner's DNS. Editing /etc/resolv.conf directly does
  # NOT persist (systemd-resolved manages it); a resolved.conf.d drop-in does. Restart
  # so it takes effect before package install / git clone need name resolution.
  - ["sh", "-c", "mkdir -p /etc/systemd/resolved.conf.d && printf '[Resolve]\\nDNS=185.12.64.1 185.12.64.2\\n' > /etc/systemd/resolved.conf.d/ftm.conf && systemctl restart systemd-resolved"]

package_update: true
packages:
  - docker.io
  - docker-compose-v2
  - cryptsetup
  - git
  - age

write_files:
  # age private key — used once to decrypt secrets, then removed from disk.
  # Comes from server metadata (Terraform var), never committed.
  - path: /root/.ftm-age.key
    permissions: "0600"
    content: |
      ${indent(6, age_private_key)}

  # Bootstrap script: mount encrypted volume, decrypt secrets to tmpfs, compose up.
  - path: /usr/local/bin/ftm-boot.sh
    permissions: "0755"
    content: |
      #!/bin/bash
      set -euo pipefail

      DEVICE="${volume_device}"
      MAPPER="ftm-data"
      MOUNT="/mnt/ftm-data"
      REPO="/opt/ftm"

      # --- LUKS at-rest encryption on the persistent volume (task 1.4) ---
      # The LUKS passphrase itself is one of the SOPS secrets, but we need the
      # volume BEFORE we have secrets. Chicken-and-egg solved by keeping the LUKS
      # key file on tmpfs, derived from the age key (operator-held). For the MVP
      # the passphrase is delivered via the same metadata channel as the age key.
      mkdir -p /run/ftm-secrets
      mount -t tmpfs -o size=8m,mode=0700 tmpfs /run/ftm-secrets

      # Clone the repo (compose + encrypted secrets). Retry: DNS/NAT may need a moment
      # to settle right after boot. Do NOT hide the error — a silent clone failure was
      # what left /opt/ftm missing before.
      if [ ! -d "$REPO/.git" ]; then
        for i in $(seq 1 20); do
          rm -rf "$REPO"
          if git clone --depth 1 --branch "${repo_ref}" "${repo_url}" "$REPO"; then
            break
          fi
          echo "ftm-boot: git clone attempt $i failed, retrying in 5s" >&2
          sleep 5
        done
      fi
      [ -d "$REPO/.git" ] || { echo "ftm-boot: clone failed after retries" >&2; exit 1; }
      export SOPS_AGE_KEY_FILE=/root/.ftm-age.key
      # sops binary is installed below via the go/deb path if not present
      command -v sops >/dev/null || {
        SOPS_VER=v3.9.4
        curl -fsSL "https://github.com/getsops/sops/releases/download/$${SOPS_VER}/sops-$${SOPS_VER}.linux.amd64" -o /usr/local/bin/sops
        chmod +x /usr/local/bin/sops
      }
      # Decrypt to dotenv format (KEY=value), NOT the source YAML (KEY: value).
      # docker compose --env-file and the LUKS_PASSPHRASE grep below both need `=`.
      sops -d --output-type dotenv "$REPO/deploy/secrets.sops.yaml" > /run/ftm-secrets/.env
      chmod 0600 /run/ftm-secrets/.env

      # Extract the LUKS passphrase from the decrypted secrets.
      LUKS_PASS="$(grep '^LUKS_PASSPHRASE=' /run/ftm-secrets/.env | cut -d= -f2-)"

      # --- Open or initialize the encrypted volume ---
      if cryptsetup isLuks "$DEVICE"; then
        echo -n "$LUKS_PASS" | cryptsetup open "$DEVICE" "$MAPPER" -
      else
        echo -n "$LUKS_PASS" | cryptsetup luksFormat "$DEVICE" -
        echo -n "$LUKS_PASS" | cryptsetup open "$DEVICE" "$MAPPER" -
        mkfs.ext4 "/dev/mapper/$MAPPER"
      fi

      mkdir -p "$MOUNT"
      mount "/dev/mapper/$MAPPER" "$MOUNT"
      mkdir -p "$MOUNT/pg-keycloak" "$MOUNT/pg-app" "$MOUNT/minio"

      # --- Bring up the stack ---
      # Inject deploy-time non-secret vars alongside the decrypted .env.
      {
        echo "DOMAIN=${domain}"
        echo "STACK_PRIVATE_IP=${stack_private_ip}"
      } >> /run/ftm-secrets/.env

      # Substitute the __DOMAIN__ placeholder in the Keycloak realm export so the
      # realm's redirect URIs / web origins match the real domain (login breaks otherwise).
      sed -i "s|__DOMAIN__|${domain}|g" "$REPO/deploy/keycloak/realm-export.json"

      cd "$REPO/deploy"
      docker compose --env-file /run/ftm-secrets/.env -f docker-compose.stack.yaml up -d

      # Wipe the age key from disk once secrets are loaded.
      shred -u /root/.ftm-age.key || rm -f /root/.ftm-age.key

runcmd:
  - systemctl enable --now docker
  - /usr/local/bin/ftm-boot.sh
