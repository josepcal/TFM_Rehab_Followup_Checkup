#cloud-config
package_update: true
packages:
  - nginx
  - certbot
  - python3-certbot-nginx
  - iptables-persistent

write_files:
  # Enable IPv4 forwarding so the edge can NAT the no-public-IP stack VM's egress.
  - path: /etc/sysctl.d/99-ip-forward.conf
    content: |
      net.ipv4.ip_forward = 1

  # NAT gateway: masquerade traffic coming from the private subnet out the public
  # interface. This lets the stack VM (no public IP) reach the internet through the
  # edge, while nothing from the internet can initiate a connection to the stack.
  - path: /usr/local/bin/ftm-nat.sh
    permissions: "0755"
    content: |
      #!/bin/bash
      set -uo pipefail
      # Public interface = the one holding the DHCP-assigned public IPv4.
      # Wait for it to appear — at early boot the default route may not exist yet,
      # which previously left PUB_IF empty and iptables rejected an empty -o.
      PUB_IF=""
      for i in $(seq 1 30); do
        PUB_IF="$(ip -o -4 route show default 2>/dev/null | awk '{print $5; exit}')"
        [ -z "$PUB_IF" ] && PUB_IF="$(ip -o -4 addr show scope global 2>/dev/null | awk '$2 !~ /^enp/ {print $2; exit}')"
        [ -n "$PUB_IF" ] && break
        sleep 2
      done
      if [ -z "$PUB_IF" ]; then
        echo "ftm-nat: could not determine public interface" >&2
        exit 1
      fi
      # Idempotent: add the masquerade rule only if it is not already present.
      if ! iptables -t nat -C POSTROUTING -s ${subnet_ip_range} -o "$PUB_IF" -j MASQUERADE 2>/dev/null; then
        iptables -t nat -A POSTROUTING -s ${subnet_ip_range} -o "$PUB_IF" -j MASQUERADE
      fi
      netfilter-persistent save

  # Configure the persistent floating IP on the public interface, ADDED to the
  # DHCP-assigned public IP (not replacing it). Hetzner's own netplan config
  # (50-cloud-init.yaml) already sets dhcp4 on eth0; this file must keep dhcp4
  # enabled too, or netplan's merge drops the DHCP address entirely.
  - path: /etc/netplan/60-floating-ip.yaml
    permissions: "0600"
    content: |
      network:
        version: 2
        ethernets:
          eth0:
            dhcp4: true
            addresses:
              - ${floating_ip_address}/32

  - path: /var/www/ftm/index.html
    content: |
      <!doctype html><title>FTM</title><h1>FTM edge</h1>
      <p>frontend served from the stack VM once it is up</p>

  # Placeholder vhost on :80 so nginx starts before TLS is issued.
  # The real routing vhost (deploy/nginx/ftm.conf, PR2) replaces this and
  # proxies /api and /realms to the stack VM's private IP.
  - path: /etc/nginx/sites-available/ftm
    content: |
      server {
          listen 80 default_server;
          server_name ${domain};
          root /var/www/ftm;
          location / { try_files $uri /index.html; }
      }

  # Idempotent TLS issuance — runs only once the domain resolves to this host.
  - path: /usr/local/bin/ftm-issue-cert.sh
    permissions: "0755"
    content: |
      #!/bin/bash
      set -euo pipefail
      if [ -d "/etc/letsencrypt/live/${domain}" ]; then
        echo "cert already present"; exit 0
      fi
      certbot --nginx --non-interactive --agree-tos \
        --email "${ssl_cert_email}" --domains "${domain}" --redirect

runcmd:
  - netplan apply
  - sysctl --system
  - /usr/local/bin/ftm-nat.sh
  - mkdir -p /var/www/ftm
  - ln -sf /etc/nginx/sites-available/ftm /etc/nginx/sites-enabled/ftm
  - rm -f /etc/nginx/sites-enabled/default
  - nginx -t && systemctl enable --now nginx
  - systemctl enable certbot.timer || true
  # NOTE: run /usr/local/bin/ftm-issue-cert.sh manually (or via re-run) AFTER the
  # DNS A record points at the floating IP — certbot needs the domain to resolve here.
