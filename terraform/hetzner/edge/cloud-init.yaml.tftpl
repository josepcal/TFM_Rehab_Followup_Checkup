#cloud-config
package_update: true
packages:
  - nginx
  - certbot
  - python3-certbot-nginx

write_files:
  # Configure the persistent floating IP on the public interface, ADDED to the
  # DHCP-assigned public IP (not replacing it). Hetzner's own netplan config
  # (50-cloud-init.yaml) already sets dhcp4 on eth0; this file must keep dhcp4
  # enabled too, or netplan's merge drops the DHCP address entirely.
  - path: /etc/netplan/60-floating-ip.yaml
    permissions: "0600"
    content: |
      network:
        version: 2
        ethernets:
          eth0:
            dhcp4: true
            addresses:
              - ${floating_ip_address}/32

  - path: /var/www/ftm/index.html
    content: |
      <!doctype html><title>FTM</title><h1>FTM edge</h1>
      <p>frontend served from the stack VM once it is up</p>

  # Placeholder vhost on :80 so nginx starts before TLS is issued.
  # The real routing vhost (deploy/nginx/ftm.conf, PR2) replaces this and
  # proxies /api and /realms to the stack VM's private IP.
  - path: /etc/nginx/sites-available/ftm
    content: |
      server {
          listen 80 default_server;
          server_name ${domain};
          root /var/www/ftm;
          location / { try_files $uri /index.html; }
      }

  # Idempotent TLS issuance — runs only once the domain resolves to this host.
  - path: /usr/local/bin/ftm-issue-cert.sh
    permissions: "0755"
    content: |
      #!/bin/bash
      set -euo pipefail
      if [ -d "/etc/letsencrypt/live/${domain}" ]; then
        echo "cert already present"; exit 0
      fi
      certbot --nginx --non-interactive --agree-tos \
        --email "${ssl_cert_email}" --domains "${domain}" --redirect

runcmd:
  - netplan apply
  - mkdir -p /var/www/ftm
  - ln -sf /etc/nginx/sites-available/ftm /etc/nginx/sites-enabled/ftm
  - rm -f /etc/nginx/sites-enabled/default
  - nginx -t && systemctl enable --now nginx
  - systemctl enable certbot.timer || true
  # NOTE: run /usr/local/bin/ftm-issue-cert.sh manually (or via re-run) AFTER the
  # DNS A record points at the floating IP — certbot needs the domain to resolve here.
